# Icinga Web 2 base URL (points to your icingaweb2 root)
ICINGA_WEB_BASE_URL=https://monitoring.example.com/icingaweb2

# Icinga Web user with access to Icinga DB Web API
ICINGA_WEB_USERNAME=api-user
ICINGA_WEB_PASSWORD=change-me

# TLS verification: "true" or "false"
ICINGA_WEB_VERIFY_TLS=true
# Optional custom CA bundle path (PEM). Leave empty for system CAs.
ICINGA_WEB_CA_BUNDLE=

# HTTP settings
HTTP_REQUEST_TIMEOUT=15.0
HTTP_MAX_RETRIES=3
HTTP_RETRY_BACKOFF=0.5

# REST server (FastAPI + Swagger)
REST_HOST=127.0.0.1
REST_PORT=8080

# REST authentication (Bearer)
REST_REQUIRE_API_KEY=false
REST_BEARER_TOKEN=